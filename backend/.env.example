APP_NAME=OpsSage AI
APP_VERSION=2.0.0
DEBUG=false

# AI provider: openai or ollama
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_SECONDS=120

# Cloud AI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=public-demo-disabled
OPENAI_MODEL=gpt-4.1-mini

# Local AI (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Generate strong random values for production.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret

OPSSAGE_API_KEY=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
