GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# AI provider: openai or ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Application security secrets - generate unique random values
AUTH_SECRET_KEY=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret

# Optional database override
DATABASE_URL=sqlite:///./opssage.db
